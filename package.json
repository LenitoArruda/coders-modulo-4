{
  "name": "coders-modulo-4",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:commit": "commitlint --edit",
    "code:fix": "turbo run lint -- --fix && prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "types:check": "turbo run types:check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "db:migrate": "bun x supabase migration up --local",
    "db:test": "bun x supabase test db",
    "prepare": "lefthook install",
    "env:setup": "cp .env.example .env",
    "local:setup": "bun i && bun env:setup && bun infra:up && bun db:migrate"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --no-config-lookup --config eslint.config.mjs --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "eslint": "10.9.1",
    "lefthook": "2.2.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.6",
    "supabase": "3.0.0",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
