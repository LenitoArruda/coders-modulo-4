# API
PORT=3333
WEB_ORIGIN=http://localhost:3000

# PostgreSQL nativo (Docker Compose). Única variável de banco da API.
# Os valores padrão do docker-compose.yml são user/password `postgres` e banco `coders_modulo_4`.
# Se a porta 5432 já estiver em uso na máquina, defina POSTGRES_PORT (ex.: 5433) e ajuste a URL.
# POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/coders_modulo_4

# OpenTelemetry (OTLP gRPC do LGTM)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=coders-modulo-4-api

# Auth session
# Segredo de assinatura dos JWTs (HS256). Obrigatório, mínimo de 32 caracteres.
# Gere um valor local com, por exemplo: openssl rand -base64 48
JWT_SECRET=
# Duração da sessão em segundos (padrão: 604800 = 7 dias)
SESSION_TTL_SECONDS=604800
# TTL do token de confirmação de e-mail em segundos (padrão: 86400 = 24 horas)
CONFIRMATION_TOKEN_TTL_SECONDS=86400
# Rate limit básico do sign-up por IP (padrão: 5 tentativas a cada 60 s)
SIGN_UP_RATE_LIMIT_MAX=5
SIGN_UP_RATE_LIMIT_WINDOW_SECONDS=60
# Rate limit básico da confirmação de conta por IP (padrão: 10 tentativas a cada 60 s)
CONFIRMATION_RATE_LIMIT_MAX=10
CONFIRMATION_RATE_LIMIT_WINDOW_SECONDS=60
# TTL do token de recuperação de senha em segundos (padrão: 3600 = 1 hora)
RESET_TOKEN_TTL_SECONDS=3600
# Rate limit básico do forgot-password por IP e por e-mail (padrão: 5 a cada 60 s)
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=60
# Rate limit do sign-in por IP + e-mail normalizado (padrão: 5 tentativas a cada 60 s; a 6ª recebe 429)
SIGN_IN_RATE_LIMIT_MAX=5
SIGN_IN_RATE_LIMIT_WINDOW_SECONDS=60
# Rate limit do reset-password por IP (padrão: 5 tentativas a cada 60 s; a 6ª recebe 429)
RESET_PASSWORD_RATE_LIMIT_MAX=5
RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=60

# Experts (fatia 1)
# Chave da OpenAI usada pelo responder gpt-4o-mini. Opcional no boot: sem ela a
# API sobe normalmente e apenas o envio de prompt responde 503 MODEL_UNAVAILABLE.
# Segredo: não commite.
OPENAI_API_KEY=
# Tamanho máximo do prompt enviado a um Expert, em caracteres (padrão: 4000).
EXPERT_PROMPT_MAX_LENGTH=4000

# RAG e citações (fatia 5)
# Desligada por padrão: com `false` o chat se comporta como na fatia 1.
# Com `true`, o Expert recupera trechos das fontes do usuário e cita com [n].
RAG_CITATIONS_ENABLED=false
# Quantidade máxima de trechos injetados e similaridade mínima (0 a 1).
RAG_TOP_K=5
RAG_THRESHOLD=0.35
# Orçamento de contexto e de histórico recente por resposta.
RAG_MAX_CONTEXT_CHARS=6000
RAG_MAX_HISTORY_MESSAGES=6

# Conhecimento e vetores (fatia 2)
# Porta do Weaviate local no Compose (padrão: 8080).
WEAVIATE_PORT=8080
# Endereço usado pela API para gravar e consultar vetores.
WEAVIATE_URL=http://127.0.0.1:8080
# Modelo de embedding decidido em 2026-11-17: text-embedding-3-small,
# 1536 dimensões e distância cosine na collection do Weaviate.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
WEAVIATE_DISTANCE=cosine

# E-mail transacional
# Ambiente de execução (opcional; padrão: dev). `production` usa Resend;
# qualquer outro valor usa Mailtrap.
NODE_ENV=dev
# Remetente compartilhado pelos provedores. O domínio precisa estar verificado
# no provedor ativo. hello@demomailtrap.co (padrão) só entrega para o e-mail
# dono da conta Mailtrap.
MAIL_FROM_EMAIL=hello@demomailtrap.co
MAIL_FROM_NAME=Experts

# Mailtrap (usado quando NODE_ENV != production)
# Token em Mailtrap > Settings > API Tokens (use o token do Sending Domain). Segredo: não commite.
# Acompanhe os envios em https://mailtrap.io/sending/email_logs
MAILTRAP_API_TOKEN=
# Dev local: envie para a sandbox do Mailtrap em vez da API de envio real.
# Aceita o token de sandbox/conta e exige MAILTRAP_SANDBOX_ID (o ID da inbox,
# visível em Mailtrap > Sandboxes). Padrão: false (envio real).
MAILTRAP_SANDBOX=false
MAILTRAP_SANDBOX_ID=

# Resend (usado quando NODE_ENV=production)
# Crie a chave em https://resend.com/api-keys. Segredo: não commite.
# O domínio de MAIL_FROM_EMAIL precisa estar verificado no Resend.
RESEND_API_KEY=

# Web -> API (usado pelo servidor do web para encaminhar Authorization: Bearer)
# O E2E sobrescreve este valor com a API fake local (127.0.0.1:3434) e não usa o banco.
API_BASE_URL=http://localhost:3333

# Entregáveis multimídia (fatia 017)
# Desligada por padrão na API e no web. No web, o cookie
# `multimedia_deliverables_enabled=1` também habilita a interface por sessão.
MULTIMEDIA_DELIVERABLES_ENABLED=false
# Modelos configuráveis; a chave OpenAI já declarada acima é reutilizada para imagens.
# GEMINI_API_KEY é um segredo e não deve ser commitado.
MEDIA_IMAGE_MODEL_ID=gpt-image-2
MEDIA_VIDEO_MODEL_ID=gemini-omni-1.2-flash
MEDIA_IMAGE_QUOTA_PER_HOUR=10
MEDIA_VIDEO_QUOTA_PER_HOUR=2
MEDIA_QUOTA_WINDOW_SECONDS=3600
MEDIA_MAX_FILE_BYTES=20971520
OPENAI_API_BASE_URL=https://api.openai.com
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
