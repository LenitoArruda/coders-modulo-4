# API
PORT=3333
WEB_ORIGIN=http://localhost:3000

# PostgreSQL nativo (Docker Compose). Única variável de banco da API.
# Os valores padrão do docker-compose.yml são user/password `postgres` e banco `coders_modulo_4`.
# Se a porta 5432 já estiver em uso na máquina, defina POSTGRES_PORT (ex.: 5433) e ajuste a URL.
# POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/coders_modulo_4

# OpenTelemetry (OTLP gRPC do LGTM)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=coders-modulo-4-api

# Auth session
# Segredo de assinatura dos JWTs (HS256). Obrigatório, mínimo de 32 caracteres.
# Gere um valor local com, por exemplo: openssl rand -base64 48
JWT_SECRET=
# Duração da sessão em segundos (padrão: 604800 = 7 dias)
SESSION_TTL_SECONDS=604800
# TTL do token de confirmação de e-mail em segundos (padrão: 86400 = 24 horas)
CONFIRMATION_TOKEN_TTL_SECONDS=86400
# Rate limit básico do sign-up por IP (padrão: 5 tentativas a cada 60 s)
SIGN_UP_RATE_LIMIT_MAX=5
SIGN_UP_RATE_LIMIT_WINDOW_SECONDS=60
# Rate limit básico da confirmação de conta por IP (padrão: 10 tentativas a cada 60 s)
CONFIRMATION_RATE_LIMIT_MAX=10
CONFIRMATION_RATE_LIMIT_WINDOW_SECONDS=60
# TTL do token de recuperação de senha em segundos (padrão: 3600 = 1 hora)
RESET_TOKEN_TTL_SECONDS=3600
# Rate limit básico do forgot-password por IP e por e-mail (padrão: 5 a cada 60 s)
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=60
# Rate limit do sign-in por IP + e-mail normalizado (padrão: 5 tentativas a cada 60 s; a 6ª recebe 429)
SIGN_IN_RATE_LIMIT_MAX=5
SIGN_IN_RATE_LIMIT_WINDOW_SECONDS=60
# Rate limit do reset-password por IP (padrão: 5 tentativas a cada 60 s; a 6ª recebe 429)
RESET_PASSWORD_RATE_LIMIT_MAX=5
RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=60

# E-mail transacional via Mailtrap (Email API, SDK `mailtrap`)
# Token em Mailtrap > Settings > API Tokens (use o token do Sending Domain). Segredo: não commite.
# Acompanhe os envios em https://mailtrap.io/sending/email_logs
MAILTRAP_API_TOKEN=
# Remetente: o domínio precisa estar verificado no Mailtrap Sending.
# hello@demomailtrap.co (padrão) só entrega para o e-mail dono da conta Mailtrap.
MAIL_FROM_EMAIL=hello@demomailtrap.co
MAIL_FROM_NAME=Experts
# Dev local: envie para a sandbox do Mailtrap em vez da API de envio real.
# Aceita o token de sandbox/conta e exige MAILTRAP_SANDBOX_ID (o ID da inbox,
# visível em Mailtrap > Sandboxes). Padrão: false (envio real).
MAILTRAP_SANDBOX=false
MAILTRAP_SANDBOX_ID=

# Web -> API (usado pelo servidor do web para encaminhar Authorization: Bearer)
# O E2E sobrescreve este valor com a API fake local (127.0.0.1:3434) e não usa o banco.
API_BASE_URL=http://localhost:3333
