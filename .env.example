# Auth session
# Segredo de assinatura dos JWTs (HS256). Obrigatório, mínimo de 32 caracteres.
# Gere um valor local com, por exemplo: openssl rand -base64 48
JWT_SECRET=
# Duração da sessão em segundos (padrão: 604800 = 7 dias)
SESSION_TTL_SECONDS=604800

# SMTP local (Mailpit do Supabase local; inbox em http://127.0.0.1:54324)
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_FROM=no-reply@localhost

# Web -> API (usado pelo servidor do web para encaminhar Authorization: Bearer)
API_BASE_URL=http://localhost:3333
