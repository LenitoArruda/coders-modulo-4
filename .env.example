SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# OpenTelemetry (OTLP gRPC do LGTM)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=coders-modulo-4-api

# Auth session
# Segredo de assinatura dos JWTs (HS256). Obrigatório, mínimo de 32 caracteres.
# Gere um valor local com, por exemplo: openssl rand -base64 48
JWT_SECRET=
# Duração da sessão em segundos (padrão: 604800 = 7 dias)
SESSION_TTL_SECONDS=604800
# TTL do token de confirmação de e-mail em segundos (padrão: 86400 = 24 horas)
CONFIRMATION_TOKEN_TTL_SECONDS=86400
# Rate limit básico do sign-up por IP (padrão: 5 tentativas a cada 60 s)
SIGN_UP_RATE_LIMIT_MAX=5
SIGN_UP_RATE_LIMIT_WINDOW_SECONDS=60
# Rate limit básico da confirmação de conta por IP (padrão: 10 tentativas a cada 60 s)
CONFIRMATION_RATE_LIMIT_MAX=10
CONFIRMATION_RATE_LIMIT_WINDOW_SECONDS=60
# TTL do token de recuperação de senha em segundos (padrão: 3600 = 1 hora)
RESET_TOKEN_TTL_SECONDS=3600
# Rate limit básico do forgot-password por IP e por e-mail (padrão: 5 a cada 60 s)
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=60
# Rate limit do sign-in por IP + e-mail normalizado (padrão: 5 tentativas a cada 60 s; a 6ª recebe 429)
SIGN_IN_RATE_LIMIT_MAX=5
SIGN_IN_RATE_LIMIT_WINDOW_SECONDS=60

# SMTP local (Mailpit do Supabase local; inbox em http://127.0.0.1:54324)
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_FROM=no-reply@localhost

# Web -> API (usado pelo servidor do web para encaminhar Authorization: Bearer)
# O E2E sobrescreve este valor com a API fake local (127.0.0.1:3434) e não usa o banco.
API_BASE_URL=http://localhost:3333
