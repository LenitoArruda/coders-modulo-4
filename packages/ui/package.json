    "@repo/typescript-config": "*",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
